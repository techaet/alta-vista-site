# Residencial Alta Vista — fallback das rotas React para Apache/HostGator
RewriteEngine On
RewriteBase /

# Força https:// e www. como versão única e canônica
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^altavistamarau\.com\.br$ [NC]
RewriteRule ^ https://www.altavistamarau.com.br%{REQUEST_URI} [L,R=301]

# Páginas pré-renderizadas no build (scripts/prerender.mjs): /blog/x -> _pages/blog/x.html
RewriteCond %{DOCUMENT_ROOT}/_pages%{REQUEST_URI}.html -f
RewriteRule ^ _pages%{REQUEST_URI}.html [L]

# Qualquer outra rota: shell vazio da SPA (o React decide, inclusive o 404)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ spa.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|ico|css|js|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
